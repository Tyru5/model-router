{
  "unattended/default": {
    "build": {
      "program": "pi",
      "args": [
        "--print",
        "--mode",
        "json",
        "@$TMP/prompt.md"
      ],
      "stdin": null,
      "kind": "Pi",
      "final_file": "$TMP/attempt/final.txt",
      "env": [],
      "files": [],
      "uses_output_schema": false
    },
    "session": {
      "assigned": true,
      "args": [
        "--print",
        "--mode",
        "json",
        "@$TMP/prompt.md",
        "--session-id",
        "<session-id>"
      ]
    },
    "resumable": true,
    "resume": {
      "program": "pi",
      "args": [
        "--session-id",
        "S-1"
      ],
      "stdin": null,
      "kind": "Pi",
      "final_file": "$TMP/attempt/final.txt",
      "env": [],
      "files": [],
      "uses_output_schema": false
    },
    "follow_up": {
      "program": "pi",
      "args": [
        "--print",
        "--mode",
        "json",
        "--session-id",
        "S-1",
        "@$TMP/prompt.md"
      ],
      "stdin": null,
      "kind": "Pi",
      "final_file": "$TMP/attempt/final.txt",
      "env": [],
      "files": [],
      "uses_output_schema": false
    }
  },
