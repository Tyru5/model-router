{
  "unattended/default": {
    "build": {
      "program": "omp",
      "args": [
        "--print",
        "--mode",
        "json",
        "@$TMP/prompt.md"
      ],
      "stdin": null,
      "kind": "Pi",
      "final_file": "$TMP/attempt/final.txt",
      "env": [],
      "files": [],
      "uses_output_schema": false
    },
    "session": {
      "assigned": false,
      "args": [
        "--print",
        "--mode",
        "json",
        "@$TMP/prompt.md"
      ]
    },
    "resumable": true,
    "resume": {
      "program": "omp",
      "args": [
        "--resume",
        "S-1"
      ],
      "stdin": null,
      "kind": "Pi",
      "final_file": "$TMP/attempt/final.txt",
      "env": [],
      "files": [],
      "uses_output_schema": false
    }
  },
