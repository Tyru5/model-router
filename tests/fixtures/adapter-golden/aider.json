  "unattended/routed": {
    "build": {
      "program": "aider",
      "args": [
        "--model",
        "openai/m-1",
        "--openai-api-base",
        "http://localhost:4000/v1",
        "--no-auto-commits",
        "--no-dirty-commits",
        "--message-file",
        "$TMP/prompt.md"
      ],
      "stdin": null,
      "kind": "Text",
      "final_file": "$TMP/attempt/final.txt",
      "env": [
        [
          "PROXY_KEY",
          {
            "var": "PROXY_KEY"
          }
        ],
        [
          "OPENAI_",
          "unset_prefix"
        ],
        [
          "AIDER_OPENAI_",
          "unset_prefix"
        ],
        [
          "OPENAI_API_BASE",
          {
            "literal": "http://localhost:4000/v1"
          }
        ],
        [
          "OPENAI_API_KEY",
          {
            "var": "PROXY_KEY"
          }
        ]
      ],
      "files": [],
      "uses_output_schema": false
    },
    "session": {
      "assigned": false,
      "args": [
        "--model",
        "openai/m-1",
        "--openai-api-base",
        "http://localhost:4000/v1",
        "--no-auto-commits",
        "--no-dirty-commits",
        "--message-file",
        "$TMP/prompt.md"
      ]
    },
    "resumable": false,
    "resume": null
  },
